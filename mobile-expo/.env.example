# Firebase Client Configuration for KASHF | كَشْف (Expo / React Native Android)
# If firebase-applet-config.json is present, these variables are optional overrides.
# Get all values from Firebase Console -> Project Settings -> General -> Your apps (Web App).
# Never put private Admin SDK service account keys here.

EXPO_PUBLIC_FIREBASE_API_KEY=""
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=""
EXPO_PUBLIC_FIREBASE_PROJECT_ID=""
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=""
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
EXPO_PUBLIC_FIREBASE_APP_ID=""
# Leave empty if using the (default) Firestore database, or set your named database ID
EXPO_PUBLIC_FIREBASE_FIRESTORE_DATABASE_ID=""
