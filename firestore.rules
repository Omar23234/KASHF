rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Startup connection check endpoint
    match /test/connection {
      allow get: if isSignedIn();
      allow list, write: if false;
    }

    // Core Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidRoomCode(code) {
      return code is string && code.size() == 6 && code.matches('^[A-Z0-9]{6}$');
    }

    function isRoomMember(roomId) {
      return exists(/databases/$(database)/documents/rooms/$(roomId)/players/$(request.auth.uid));
    }

    function isValidLastCardEvent(evt) {
      return evt == null || (
        evt is map
        && evt.nonce is int && evt.nonce >= 1
        && evt.type in ['awarded', 'gold', 'switch', 'anti_switch']
        && evt.cardId is string && evt.cardId.size() >= 1 && evt.cardId.size() <= 32
        && evt.actorUid is string && evt.actorUid.size() >= 1 && evt.actorUid.size() <= 128
        && evt.actorName is string && evt.actorName.size() >= 1 && evt.actorName.size() <= 24
        && (evt.targetUid == null || (evt.targetUid is string && evt.targetUid.size() >= 1 && evt.targetUid.size() <= 128))
        && (evt.targetName == null || (evt.targetName is string && evt.targetName.size() >= 1 && evt.targetName.size() <= 24))
      );
    }

    // Validation Blueprint: Room
    function isValidRoom(data) {
      return data.keys().hasAll([
          'roomCode', 'hostId', 'status', 'gameNumber', 'gameMode', 'language',
          'roundsCount', 'randomFirstPlayer', 'soundEnabled', 'playerOrder',
          'playerCount', 'currentTurnIndex', 'currentRound', 'totalTurnsCompleted',
          'completedQuestionsCount', 'skippedQuestionsCount', 'currentQuestionId',
          'usedQuestionIds', 'activePlayerId', 'turnNonce',
          'turnQuestionsRemaining', 'turnMode', 'switchSourceId', 'switchTargetId',
          'availableSpecialCards', 'awardedCardIds', 'lastCardEvent',
          'createdAt', 'updatedAt', 'expiresAt'
        ])
        && data.keys().hasOnly([
          'roomCode', 'hostId', 'status', 'gameNumber', 'gameMode', 'language',
          'roundsCount', 'randomFirstPlayer', 'soundEnabled', 'playerOrder',
          'playerCount', 'currentTurnIndex', 'currentRound', 'totalTurnsCompleted',
          'completedQuestionsCount', 'skippedQuestionsCount', 'currentQuestionId',
          'usedQuestionIds', 'activePlayerId', 'turnNonce',
          'turnQuestionsRemaining', 'turnMode', 'switchSourceId', 'switchTargetId',
          'availableSpecialCards', 'awardedCardIds', 'lastCardEvent',
          'createdAt', 'updatedAt', 'expiresAt'
        ])
        && isValidRoomCode(data.roomCode)
        && isValidId(data.hostId)
        && data.status in ['waiting', 'playing', 'finished', 'exhausted', 'closed']
        && data.gameNumber is int && data.gameNumber >= 1 && data.gameNumber <= 1000
        && data.gameMode in ['rounds', 'all_questions']
        && data.language in ['ar', 'en']
        && data.roundsCount is int && data.roundsCount >= 1 && data.roundsCount <= 31
        && data.randomFirstPlayer is bool
        && data.soundEnabled is bool
        && data.playerOrder is list && data.playerOrder.size() >= 0 && data.playerOrder.size() <= 12
        && (data.playerOrder.size() == 0 || isValidId(data.playerOrder[0]))
        && data.playerCount is int && data.playerCount == data.playerOrder.size()
        && data.currentTurnIndex is int && data.currentTurnIndex >= 0 && data.currentTurnIndex <= 12
        && data.currentRound is int && data.currentRound >= 1 && data.currentRound <= 31
        && data.totalTurnsCompleted is int && data.totalTurnsCompleted >= 0 && data.totalTurnsCompleted <= 200
        && data.completedQuestionsCount is int && data.completedQuestionsCount >= 0 && data.completedQuestionsCount <= 63
        && data.skippedQuestionsCount is int && data.skippedQuestionsCount >= 0 && data.skippedQuestionsCount <= 36
        && (data.currentQuestionId == null || (data.currentQuestionId is int && data.currentQuestionId >= 1 && data.currentQuestionId <= 63))
        && data.usedQuestionIds is list && data.usedQuestionIds.size() >= 0 && data.usedQuestionIds.size() <= 63
        && (data.usedQuestionIds.size() == 0 || data.usedQuestionIds[0] is int)
        && (data.activePlayerId == null || isValidId(data.activePlayerId))
        && data.turnNonce is int && data.turnNonce >= 0 && data.turnNonce <= 100000
        && data.turnQuestionsRemaining is int && data.turnQuestionsRemaining >= 1 && data.turnQuestionsRemaining <= 2
        && data.turnMode in ['normal', 'switch_pending', 'anti_switch_forced']
        && (data.switchSourceId == null || isValidId(data.switchSourceId))
        && (data.switchTargetId == null || isValidId(data.switchTargetId))
        && data.availableSpecialCards is list && data.availableSpecialCards.size() >= 0 && data.availableSpecialCards.size() <= 5
        && data.awardedCardIds is list && data.awardedCardIds.size() >= 0 && data.awardedCardIds.size() <= 5
        && (data.availableSpecialCards.size() + data.awardedCardIds.size() <= 5)
        && isValidLastCardEvent(data.lastCardEvent)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.expiresAt is timestamp;
    }

    // Validation Blueprint: RoomPlayer
    function isValidPlayer(data) {
      return data.keys().hasAll([
          'uid', 'name', 'avatarColor', 'isHost', 'score', 'skipsRemaining',
          'skipsUsed', 'pendingDoubleTurn', 'doublePenaltyUsed',
          'goldCards', 'switchCards', 'antiSwitchCards',
          'voiceJoined', 'micMuted', 'connected', 'joinedAt', 'lastSeenAt'
        ])
        && data.keys().hasOnly([
          'uid', 'name', 'avatarColor', 'isHost', 'score', 'skipsRemaining',
          'skipsUsed', 'pendingDoubleTurn', 'doublePenaltyUsed',
          'goldCards', 'switchCards', 'antiSwitchCards',
          'voiceJoined', 'micMuted', 'connected', 'joinedAt', 'lastSeenAt'
        ])
        && isValidId(data.uid)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 24
        && data.avatarColor is string && data.avatarColor.size() >= 1 && data.avatarColor.size() <= 24
        && data.isHost is bool
        && data.score is int && data.score >= -1000 && data.score <= 1000
        && data.skipsRemaining is int && data.skipsRemaining >= 0 && data.skipsRemaining <= 3
        && data.skipsUsed is int && data.skipsUsed >= 0 && data.skipsUsed <= 3
        && (data.skipsRemaining + data.skipsUsed == 3)
        && data.pendingDoubleTurn is bool
        && data.doublePenaltyUsed is bool
        && data.goldCards is int && data.goldCards >= 0 && data.goldCards <= 2
        && data.switchCards is int && data.switchCards >= 0 && data.switchCards <= 2
        && data.antiSwitchCards is int && data.antiSwitchCards >= 0 && data.antiSwitchCards <= 1
        && data.voiceJoined is bool
        && data.micMuted is bool
        && data.connected is bool
        && data.joinedAt is timestamp
        && data.lastSeenAt is timestamp;
    }

    function isValidRoomUpdateSchema(data, prev) {
      return data.diff(prev).addedKeys().size() == 0
        && data.diff(prev).removedKeys().size() == 0
        && data.roomCode == prev.roomCode
        && data.createdAt == prev.createdAt
        && data.expiresAt == prev.expiresAt
        && data.updatedAt == request.time
        && isValidId(data.hostId)
        && data.status in ['waiting', 'playing', 'finished', 'exhausted', 'closed']
        && data.gameMode in ['rounds', 'all_questions']
        && data.language in ['ar', 'en']
        && data.roundsCount is int && data.roundsCount >= 1 && data.roundsCount <= 31
        && data.randomFirstPlayer is bool
        && data.soundEnabled is bool
        && data.playerOrder is list && data.playerOrder.size() >= 0 && data.playerOrder.size() <= 12
        && data.playerCount is int && data.playerCount == data.playerOrder.size()
        && data.currentTurnIndex is int && data.currentTurnIndex >= 0 && data.currentTurnIndex <= 12
        && data.currentRound is int && data.currentRound >= 1 && data.currentRound <= 31
        && data.totalTurnsCompleted is int && data.totalTurnsCompleted >= 0 && data.totalTurnsCompleted <= 200
        && data.completedQuestionsCount is int && data.completedQuestionsCount >= 0 && data.completedQuestionsCount <= 63
        && data.skippedQuestionsCount is int && data.skippedQuestionsCount >= 0 && data.skippedQuestionsCount <= 36
        && data.turnNonce is int && data.turnNonce >= 0 && data.turnNonce <= 100000
        && data.turnQuestionsRemaining is int && data.turnQuestionsRemaining >= 1 && data.turnQuestionsRemaining <= 2
        && data.turnMode in ['normal', 'switch_pending', 'anti_switch_forced']
        && data.availableSpecialCards is list && data.availableSpecialCards.size() <= 5
        && data.awardedCardIds is list && data.awardedCardIds.size() <= 5
        && (data.availableSpecialCards.size() + data.awardedCardIds.size() <= 5)
        && (data.lastCardEvent == prev.lastCardEvent || isValidLastCardEvent(data.lastCardEvent));
    }

    function isValidCardAwardChange() {
      return (
        incoming().availableSpecialCards == existing().availableSpecialCards
        && incoming().awardedCardIds == existing().awardedCardIds
      ) || (
        existing().availableSpecialCards.size() >= 1
        && incoming().availableSpecialCards.size() == existing().availableSpecialCards.size() - 1
        && (incoming().availableSpecialCards.size() == 0 || existing().availableSpecialCards.hasAll(incoming().availableSpecialCards))
        && incoming().awardedCardIds.size() == existing().awardedCardIds.size() + 1
        && (existing().awardedCardIds.size() == 0 || incoming().awardedCardIds.hasAll(existing().awardedCardIds))
        && incoming().lastCardEvent is map
        && incoming().lastCardEvent.type == 'awarded'
        && incoming().lastCardEvent.nonce == incoming().turnNonce
      );
    }

    function isValidNextQuestionState() {
      return (
        incoming().status == 'playing'
        && incoming().currentQuestionId is int
        && incoming().currentQuestionId >= 1 && incoming().currentQuestionId <= 63
        && !(incoming().currentQuestionId in existing().usedQuestionIds)
        && incoming().currentQuestionId in incoming().usedQuestionIds
        && incoming().usedQuestionIds.hasAll(existing().usedQuestionIds)
        && incoming().usedQuestionIds.size() == existing().usedQuestionIds.size() + 1
        && incoming().currentTurnIndex < existing().playerOrder.size()
        && incoming().activePlayerId == existing().playerOrder[incoming().currentTurnIndex]
      )
      || (
        incoming().status in ['finished', 'exhausted']
        && incoming().currentQuestionId == null
        && incoming().activePlayerId == null
      );
    }

    // Room Update Action Helpers
    function isJoinRoomAction(roomId) {
      return existing().status == 'waiting'
        && incoming().status == 'waiting'
        && incoming().diff(existing()).affectedKeys().hasOnly(['playerOrder', 'playerCount', 'updatedAt'])
        && existing().playerOrder.size() < 12
        && !(request.auth.uid in existing().playerOrder)
        && request.auth.uid in incoming().playerOrder
        && incoming().playerOrder.size() == existing().playerOrder.size() + 1
        && incoming().playerOrder.hasAll(existing().playerOrder)
        && incoming().playerCount == existing().playerCount + 1
        && existsAfter(/databases/$(database)/documents/rooms/$(roomId)/players/$(request.auth.uid));
    }

    function isLeaveRoomAction(roomId) {
      return existing().status != 'closed'
        && request.auth.uid in existing().playerOrder
        && request.auth.uid != existing().hostId
        && !(request.auth.uid in incoming().playerOrder)
        && incoming().playerOrder.size() == existing().playerOrder.size() - 1
        && existing().playerOrder.hasAll(incoming().playerOrder)
        && incoming().playerCount == existing().playerCount - 1
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'playerOrder', 'playerCount', 'currentTurnIndex', 'activePlayerId',
          'currentQuestionId', 'turnQuestionsRemaining', 'turnMode',
          'switchSourceId', 'switchTargetId', 'turnNonce', 'status', 'updatedAt'
        ])
        && !existsAfter(/databases/$(database)/documents/rooms/$(roomId)/players/$(request.auth.uid));
    }

    function isHostKickPlayerAction() {
      return existing().hostId == request.auth.uid
        && existing().status == 'waiting'
        && incoming().status == 'waiting'
        && incoming().diff(existing()).affectedKeys().hasOnly(['playerOrder', 'playerCount', 'updatedAt'])
        && incoming().playerOrder.size() == existing().playerOrder.size() - 1
        && existing().playerOrder.hasAll(incoming().playerOrder)
        && existing().hostId in incoming().playerOrder
        && incoming().playerCount == existing().playerCount - 1;
    }

    function isUpdateLobbySettingsAction() {
      return existing().hostId == request.auth.uid
        && existing().status == 'waiting'
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'gameMode', 'roundsCount', 'randomFirstPlayer', 'language', 'soundEnabled', 'updatedAt'
        ])
        && (
          incoming().gameMode == 'all_questions'
          || (incoming().roundsCount * incoming().playerOrder.size() <= 63)
        );
    }

    function isHostStartOrRestartGameAction() {
      return existing().hostId == request.auth.uid
        && existing().status in ['waiting', 'finished', 'exhausted']
        && incoming().status == 'playing'
        && incoming().playerOrder.size() >= 2
        && (
          incoming().gameMode == 'all_questions'
          || (incoming().roundsCount * incoming().playerOrder.size() <= 63)
        )
        && incoming().playerOrder.hasAll(existing().playerOrder)
        && existing().playerOrder.hasAll(incoming().playerOrder)
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'gameNumber', 'gameMode', 'playerOrder', 'currentTurnIndex', 'currentRound',
          'totalTurnsCompleted', 'completedQuestionsCount', 'skippedQuestionsCount',
          'currentQuestionId', 'usedQuestionIds', 'activePlayerId', 'turnNonce',
          'turnQuestionsRemaining', 'turnMode', 'switchSourceId', 'switchTargetId',
          'availableSpecialCards', 'awardedCardIds', 'lastCardEvent',
          'roundsCount', 'randomFirstPlayer', 'language', 'soundEnabled', 'updatedAt'
        ])
        && incoming().currentRound == 1
        && incoming().currentTurnIndex == 0
        && incoming().totalTurnsCompleted == 0
        && incoming().completedQuestionsCount == 0
        && incoming().skippedQuestionsCount == 0
        && incoming().currentQuestionId is int
        && incoming().currentQuestionId >= 1 && incoming().currentQuestionId <= 63
        && incoming().usedQuestionIds.size() == 1
        && incoming().usedQuestionIds[0] == incoming().currentQuestionId
        && incoming().activePlayerId == incoming().playerOrder[0]
        && incoming().turnNonce == existing().turnNonce + 1
        && incoming().turnQuestionsRemaining == 1
        && incoming().turnMode == 'normal'
        && incoming().switchSourceId == null
        && incoming().switchTargetId == null
        && incoming().availableSpecialCards.size() == 5
        && incoming().awardedCardIds.size() == 0
        && incoming().lastCardEvent == null
        && (
          (existing().status == 'waiting' && incoming().gameNumber == existing().gameNumber)
          || (existing().status in ['finished', 'exhausted'] && incoming().gameNumber == existing().gameNumber + 1)
        );
    }

    function isNextQuestionDelta() {
      return (request.auth.uid == existing().activePlayerId || request.auth.uid == existing().hostId)
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'currentTurnIndex', 'currentRound', 'totalTurnsCompleted',
          'completedQuestionsCount', 'currentQuestionId', 'usedQuestionIds',
          'activePlayerId', 'turnNonce', 'turnQuestionsRemaining',
          'turnMode', 'switchSourceId', 'switchTargetId',
          'availableSpecialCards', 'awardedCardIds', 'lastCardEvent', 'updatedAt'
        ])
        && incoming().completedQuestionsCount == existing().completedQuestionsCount + 1
        && incoming().turnMode == 'normal'
        && incoming().switchSourceId == null
        && incoming().switchTargetId == null;
    }

    function checkSkipPlayerDelta(beforePlayer, afterPlayer) {
      return beforePlayer.skipsRemaining >= 1
        && afterPlayer.skipsRemaining == beforePlayer.skipsRemaining - 1
        && afterPlayer.score == beforePlayer.score - 3;
    }

    function isSkipQuestionDelta(roomId) {
      return existing().turnMode == 'normal'
        && request.auth.uid == existing().activePlayerId
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'currentTurnIndex', 'currentRound', 'totalTurnsCompleted',
          'skippedQuestionsCount', 'currentQuestionId', 'usedQuestionIds',
          'activePlayerId', 'turnNonce', 'turnQuestionsRemaining',
          'availableSpecialCards', 'awardedCardIds', 'lastCardEvent', 'updatedAt'
        ])
        && incoming().skippedQuestionsCount == existing().skippedQuestionsCount + 1
        && checkSkipPlayerDelta(
          get(/databases/$(database)/documents/rooms/$(roomId)/players/$(request.auth.uid)).data,
          getAfter(/databases/$(database)/documents/rooms/$(roomId)/players/$(request.auth.uid)).data
        );
    }

    function checkGoldPlayerDelta(beforePlayer, afterPlayer) {
      return beforePlayer.goldCards >= 1
        && afterPlayer.goldCards == beforePlayer.goldCards - 1
        && afterPlayer.score == beforePlayer.score;
    }

    function isUseGoldCardDelta(roomId) {
      return existing().turnMode == 'normal'
        && request.auth.uid == existing().activePlayerId
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'currentTurnIndex', 'currentRound', 'totalTurnsCompleted',
          'currentQuestionId', 'usedQuestionIds', 'activePlayerId', 'turnNonce',
          'turnQuestionsRemaining', 'availableSpecialCards', 'awardedCardIds',
          'lastCardEvent', 'updatedAt'
        ])
        && checkGoldPlayerDelta(
          get(/databases/$(database)/documents/rooms/$(roomId)/players/$(request.auth.uid)).data,
          getAfter(/databases/$(database)/documents/rooms/$(roomId)/players/$(request.auth.uid)).data
        );
    }

    function isTurnAdvanceAction(roomId) {
      return existing().status == 'playing'
        && incoming().status in ['playing', 'finished', 'exhausted']
        && incoming().turnNonce == existing().turnNonce + 1
        && incoming().totalTurnsCompleted == existing().totalTurnsCompleted + 1
        && (
          isNextQuestionDelta()
          || isSkipQuestionDelta(roomId)
          || isUseGoldCardDelta(roomId)
        )
        && isValidCardAwardChange()
        && isValidNextQuestionState();
    }

    function checkSwitchPlayerDelta(beforePlayer, afterPlayer) {
      return beforePlayer.switchCards >= 1
        && afterPlayer.switchCards == beforePlayer.switchCards - 1;
    }

    function isUseSwitchCardAction(roomId) {
      return existing().status == 'playing'
        && existing().turnMode == 'normal'
        && request.auth.uid == existing().activePlayerId
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'turnMode', 'switchSourceId', 'switchTargetId', 'activePlayerId',
          'turnNonce', 'lastCardEvent', 'updatedAt'
        ])
        && incoming().status == 'playing'
        && incoming().turnMode == 'switch_pending'
        && incoming().switchSourceId == request.auth.uid
        && incoming().switchTargetId != null
        && incoming().switchTargetId != request.auth.uid
        && incoming().switchTargetId in existing().playerOrder
        && incoming().activePlayerId == incoming().switchTargetId
        && incoming().turnNonce == existing().turnNonce + 1
        && incoming().lastCardEvent != null
        && incoming().lastCardEvent.type == 'switch'
        && incoming().lastCardEvent.nonce == incoming().turnNonce
        && checkSwitchPlayerDelta(
          get(/databases/$(database)/documents/rooms/$(roomId)/players/$(request.auth.uid)).data,
          getAfter(/databases/$(database)/documents/rooms/$(roomId)/players/$(request.auth.uid)).data
        );
    }

    function checkAntiSwitchPlayerDelta(beforePlayer, afterPlayer) {
      return beforePlayer.antiSwitchCards >= 1
        && afterPlayer.antiSwitchCards == beforePlayer.antiSwitchCards - 1;
    }

    function isUseAntiSwitchCardAction(roomId) {
      return existing().status == 'playing'
        && existing().turnMode == 'switch_pending'
        && request.auth.uid == existing().switchTargetId
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'turnMode', 'switchTargetId', 'activePlayerId', 'turnNonce', 'lastCardEvent', 'updatedAt'
        ])
        && incoming().status == 'playing'
        && incoming().turnMode == 'anti_switch_forced'
        && incoming().switchTargetId == null
        && incoming().activePlayerId == existing().switchSourceId
        && incoming().turnNonce == existing().turnNonce + 1
        && incoming().lastCardEvent != null
        && incoming().lastCardEvent.type == 'anti_switch'
        && incoming().lastCardEvent.nonce == incoming().turnNonce
        && checkAntiSwitchPlayerDelta(
          get(/databases/$(database)/documents/rooms/$(roomId)/players/$(request.auth.uid)).data,
          getAfter(/databases/$(database)/documents/rooms/$(roomId)/players/$(request.auth.uid)).data
        );
    }

    function isTransferHostAction(roomId) {
      return existing().status != 'closed'
        && request.auth.uid in existing().playerOrder
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'hostId', 'playerOrder', 'playerCount', 'currentTurnIndex', 'activePlayerId',
          'currentQuestionId', 'turnQuestionsRemaining', 'turnMode',
          'switchSourceId', 'switchTargetId', 'turnNonce', 'status', 'updatedAt'
        ])
        && incoming().hostId in incoming().playerOrder
        && incoming().hostId != existing().hostId
        && (
          (incoming().playerOrder == existing().playerOrder && incoming().playerCount == existing().playerCount)
          || (
            request.auth.uid == existing().hostId
            && !(request.auth.uid in incoming().playerOrder)
            && incoming().playerOrder.size() == existing().playerOrder.size() - 1
            && existing().playerOrder.hasAll(incoming().playerOrder)
            && incoming().playerCount == existing().playerCount - 1
          )
        )
        && (
          request.auth.uid == existing().hostId
          || get(/databases/$(database)/documents/rooms/$(roomId)/players/$(existing().hostId)).data.connected == false
        );
    }

    function isCloseRoomAction() {
      return existing().hostId == request.auth.uid
        && existing().status != 'closed'
        && incoming().status == 'closed'
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
    }

    function isValidReplyMetadata(data) {
      return (
        !('replyToMessageId' in data)
        && !('replyToSenderName' in data)
        && !('replyToPreviewText' in data)
        && !('replyToType' in data)
      ) || (
        data.keys().hasAll([
          'replyToMessageId', 'replyToSenderName', 'replyToPreviewText', 'replyToType'
        ])
        && isValidId(data.replyToMessageId)
        && data.replyToSenderName is string && data.replyToSenderName.size() >= 1 && data.replyToSenderName.size() <= 24
        && data.replyToPreviewText is string && data.replyToPreviewText.size() >= 1 && data.replyToPreviewText.size() <= 160
        && data.replyToType in ['text', 'voice']
      );
    }

    function isValidRoomChatMessage(data) {
      return data.keys().hasAll(['senderId', 'senderName', 'text', 'memberIds', 'createdAt'])
        && data.keys().hasOnly([
          'senderId', 'senderName', 'text', 'memberIds', 'createdAt',
          'messageType',
          'audioUrl', 'audioStoragePath', 'audioDurationSec', 'audioMimeType',
          'replyToMessageId', 'replyToSenderName', 'replyToPreviewText', 'replyToType'
        ])
        && data.senderId == request.auth.uid
        && data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 24
        && data.memberIds is list && data.memberIds.size() >= 1 && data.memberIds.size() <= 12
        && (data.memberIds[0] is string)
        && request.auth.uid in data.memberIds
        && data.createdAt == request.time
        && isValidReplyMetadata(data)
        && (
          (
            (!('messageType' in data) || data.messageType == 'text')
            && data.text is string && data.text.size() >= 1 && data.text.size() <= 500
            && !('audioUrl' in data)
            && !('audioStoragePath' in data)
            && !('audioDurationSec' in data)
            && !('audioMimeType' in data)
          )
          || (
            ('messageType' in data && data.messageType == 'voice')
            && data.keys().hasAll([
              'messageType', 'audioUrl', 'audioStoragePath', 'audioDurationSec', 'audioMimeType'
            ])
            && data.text is string && data.text.size() >= 1 && data.text.size() <= 100
            && data.audioUrl is string
            && (
              (data.audioUrl.size() >= 10 && data.audioUrl.size() <= 2048 && data.audioUrl.matches('^https://.*'))
              || (
                data.audioUrl.size() >= 30
                && data.audioUrl.size() <= 700000
                && data.audioUrl.matches('^data:audio/[a-zA-Z0-9.+_-]+;base64,[A-Za-z0-9+/=]+$')
              )
            )
            && data.audioStoragePath is string && data.audioStoragePath.size() >= 3 && data.audioStoragePath.size() <= 512
            && data.audioDurationSec is int && data.audioDurationSec >= 1 && data.audioDurationSec <= 180
            && data.audioMimeType is string && data.audioMimeType.size() >= 3 && data.audioMimeType.size() <= 64
            && data.audioMimeType.matches('^audio/.*')
          )
        );
    }

    function isValidMessageReaction(data, reactionId) {
      return data.keys().hasAll([
          'reactionId', 'messageId', 'userId', 'userName', 'emoji', 'memberIds', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'reactionId', 'messageId', 'userId', 'userName', 'emoji', 'memberIds', 'updatedAt'
        ])
        && isValidId(data.reactionId)
        && isValidId(data.messageId)
        && data.userId == request.auth.uid
        && data.reactionId == reactionId
        && reactionId == (data.messageId + '_' + request.auth.uid)
        && data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 24
        && data.emoji in ['❤️', '😂', '😮', '😢', '👍', '👎']
        && data.memberIds is list && data.memberIds.size() >= 1 && data.memberIds.size() <= 12
        && request.auth.uid in data.memberIds
        && data.updatedAt == request.time;
    }

    function isValidChatPresence(data) {
      return data.keys().hasAll([
          'uid', 'name', 'status', 'memberIds', 'expiresAtMs', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'name', 'status', 'memberIds', 'expiresAtMs', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 24
        && data.status in ['idle', 'typing', 'recording']
        && data.memberIds is list && data.memberIds.size() >= 1 && data.memberIds.size() <= 12
        && (data.memberIds[0] is string)
        && request.auth.uid in data.memberIds
        && data.expiresAtMs is int && data.expiresAtMs >= 0
        && data.updatedAt == request.time;
    }

    match /rooms/{roomId} {
      allow get: if isSignedIn() && isValidRoomCode(roomId);
      allow list: if false;

      allow create: if isSignedIn()
        && isValidRoomCode(roomId)
        && isValidRoom(incoming())
        && incoming().roomCode == roomId
        && incoming().hostId == request.auth.uid
        && incoming().status == 'waiting'
        && incoming().gameNumber == 1
        && incoming().playerOrder.size() == 1
        && incoming().playerOrder[0] == request.auth.uid
        && incoming().playerCount == 1
        && incoming().currentTurnIndex == 0
        && incoming().currentRound == 1
        && incoming().totalTurnsCompleted == 0
        && incoming().completedQuestionsCount == 0
        && incoming().skippedQuestionsCount == 0
        && incoming().currentQuestionId == null
        && incoming().usedQuestionIds.size() == 0
        && incoming().activePlayerId == null
        && incoming().turnNonce == 0
        && incoming().turnQuestionsRemaining == 1
        && incoming().turnMode == 'normal'
        && incoming().switchSourceId == null
        && incoming().switchTargetId == null
        && incoming().availableSpecialCards.size() == 0
        && incoming().awardedCardIds.size() == 0
        && incoming().lastCardEvent == null
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && incoming().expiresAt > request.time
        && existsAfter(/databases/$(database)/documents/rooms/$(roomId)/players/$(request.auth.uid));

      function isBaseValidRoomUpdate() {
        return isSignedIn()
          && isValidRoomCode(roomId)
          && existing().status != 'closed'
          && isValidRoomUpdateSchema(incoming(), existing());
      }

      allow update: if isBaseValidRoomUpdate() && (
        isHostStartOrRestartGameAction()
        || isTurnAdvanceAction(roomId)
        || isUpdateLobbySettingsAction()
        || isHostKickPlayerAction()
        || isCloseRoomAction()
        || isJoinRoomAction(roomId)
        || isUseSwitchCardAction(roomId)
        || isUseAntiSwitchCardAction(roomId)
        || isLeaveRoomAction(roomId)
        || isTransferHostAction(roomId)
      );

      allow delete: if false;

      match /players/{playerId} {
        allow get: if isSignedIn()
          && isValidRoomCode(roomId)
          && isValidId(playerId)
          && (playerId == request.auth.uid || isRoomMember(roomId));
        allow list: if false;

        allow create: if isSignedIn()
          && isValidRoomCode(roomId)
          && isValidId(playerId)
          && playerId == request.auth.uid
          && isValidPlayer(incoming())
          && incoming().uid == request.auth.uid
          && incoming().score == 0
          && incoming().skipsRemaining == 3
          && incoming().skipsUsed == 0
          && incoming().pendingDoubleTurn == false
          && incoming().doublePenaltyUsed == false
          && incoming().goldCards == 0
          && incoming().switchCards == 0
          && incoming().antiSwitchCards == 0
          && incoming().voiceJoined == false
          && incoming().micMuted == false
          && incoming().joinedAt == request.time
          && incoming().lastSeenAt == request.time
          && getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.status == 'waiting'
          && request.auth.uid in getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.playerOrder
          && (
            (incoming().isHost == true && getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.hostId == request.auth.uid)
            || (incoming().isHost == false && getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.hostId != request.auth.uid)
          );

        allow update: if isSignedIn()
          && isValidRoomCode(roomId)
          && isValidId(playerId)
          && isValidPlayer(incoming())
          && incoming().uid == existing().uid
          && incoming().joinedAt == existing().joinedAt
          && (
            // Heartbeat / Reconnect / Voice status
            (
              playerId == request.auth.uid
              && incoming().diff(existing()).affectedKeys().hasOnly(['connected', 'voiceJoined', 'micMuted', 'lastSeenAt'])
              && incoming().lastSeenAt == request.time
            )
            ||
            // Self avatar update while waiting in lobby
            (
              playerId == request.auth.uid
              && get(/databases/$(database)/documents/rooms/$(roomId)).data.status == 'waiting'
              && incoming().diff(existing()).affectedKeys().hasOnly(['avatarColor', 'lastSeenAt'])
              && incoming().lastSeenAt == request.time
            )
            ||
            // Answering active player (+1 score, and optionally receiving 1 random card if staying active)
            (
              (playerId == request.auth.uid || get(/databases/$(database)/documents/rooms/$(roomId)).data.hostId == request.auth.uid)
              && get(/databases/$(database)/documents/rooms/$(roomId)).data.activePlayerId == playerId
              && getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.turnNonce
                == get(/databases/$(database)/documents/rooms/$(roomId)).data.turnNonce + 1
              && getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.completedQuestionsCount
                == get(/databases/$(database)/documents/rooms/$(roomId)).data.completedQuestionsCount + 1
              && incoming().score == existing().score + 1
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'score', 'goldCards', 'switchCards', 'antiSwitchCards', 'lastSeenAt'
              ])
              && (
                (
                  incoming().goldCards == existing().goldCards
                  && incoming().switchCards == existing().switchCards
                  && incoming().antiSwitchCards == existing().antiSwitchCards
                )
                || (
                  (incoming().goldCards + incoming().switchCards + incoming().antiSwitchCards)
                    == (existing().goldCards + existing().switchCards + existing().antiSwitchCards + 1)
                  && getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.awardedCardIds.size()
                    == get(/databases/$(database)/documents/rooms/$(roomId)).data.awardedCardIds.size() + 1
                  && getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.lastCardEvent.type == 'awarded'
                  && getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.lastCardEvent.actorUid == playerId
                )
              )
            )
            ||
            // Atomic Skip Deduction (-3 score, skips -1, 3rd skip arms double turn)
            (
              playerId == request.auth.uid
              && existing().skipsRemaining >= 1
              && incoming().skipsRemaining == existing().skipsRemaining - 1
              && incoming().skipsUsed == existing().skipsUsed + 1
              && incoming().score == existing().score - 3
              && incoming().pendingDoubleTurn == (
                (incoming().skipsUsed == 3 && !existing().doublePenaltyUsed) ? true : existing().pendingDoubleTurn
              )
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'skipsRemaining', 'skipsUsed', 'score', 'pendingDoubleTurn', 'lastSeenAt'
              ])
              && incoming().lastSeenAt == request.time
              && get(/databases/$(database)/documents/rooms/$(roomId)).data.activePlayerId == request.auth.uid
              && getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.turnNonce
                == get(/databases/$(database)/documents/rooms/$(roomId)).data.turnNonce + 1
              && getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.skippedQuestionsCount
                == get(/databases/$(database)/documents/rooms/$(roomId)).data.skippedQuestionsCount + 1
            )
            ||
            // Gold Card Use (goldCards - 1, 0 score change)
            (
              playerId == request.auth.uid
              && existing().goldCards >= 1
              && incoming().goldCards == existing().goldCards - 1
              && incoming().diff(existing()).affectedKeys().hasOnly(['goldCards', 'lastSeenAt'])
              && incoming().lastSeenAt == request.time
              && get(/databases/$(database)/documents/rooms/$(roomId)).data.activePlayerId == request.auth.uid
              && getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.turnNonce
                == get(/databases/$(database)/documents/rooms/$(roomId)).data.turnNonce + 1
            )
            ||
            // Switch Card Use (switchCards - 1)
            (
              playerId == request.auth.uid
              && existing().switchCards >= 1
              && incoming().switchCards == existing().switchCards - 1
              && incoming().diff(existing()).affectedKeys().hasOnly(['switchCards', 'lastSeenAt'])
              && incoming().lastSeenAt == request.time
              && get(/databases/$(database)/documents/rooms/$(roomId)).data.activePlayerId == request.auth.uid
              && getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.turnMode == 'switch_pending'
              && getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.turnNonce
                == get(/databases/$(database)/documents/rooms/$(roomId)).data.turnNonce + 1
            )
            ||
            // Anti-Switch Card Use (antiSwitchCards - 1)
            (
              playerId == request.auth.uid
              && existing().antiSwitchCards >= 1
              && incoming().antiSwitchCards == existing().antiSwitchCards - 1
              && incoming().diff(existing()).affectedKeys().hasOnly(['antiSwitchCards', 'lastSeenAt'])
              && incoming().lastSeenAt == request.time
              && get(/databases/$(database)/documents/rooms/$(roomId)).data.switchTargetId == request.auth.uid
              && getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.turnMode == 'anti_switch_forced'
              && getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.turnNonce
                == get(/databases/$(database)/documents/rooms/$(roomId)).data.turnNonce + 1
            )
            ||
            // Next incoming player receiving 1 random card reward and/or activating 1-time double penalty
            (
              (
                get(/databases/$(database)/documents/rooms/$(roomId)).data.activePlayerId == request.auth.uid
                || get(/databases/$(database)/documents/rooms/$(roomId)).data.hostId == request.auth.uid
              )
              && getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.activePlayerId == playerId
              && getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.turnNonce
                == get(/databases/$(database)/documents/rooms/$(roomId)).data.turnNonce + 1
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'goldCards', 'switchCards', 'antiSwitchCards', 'pendingDoubleTurn', 'doublePenaltyUsed'
              ])
              && (
                (
                  incoming().goldCards == existing().goldCards
                  && incoming().switchCards == existing().switchCards
                  && incoming().antiSwitchCards == existing().antiSwitchCards
                )
                || (
                  (incoming().goldCards + incoming().switchCards + incoming().antiSwitchCards)
                    == (existing().goldCards + existing().switchCards + existing().antiSwitchCards + 1)
                  && getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.awardedCardIds.size()
                    == get(/databases/$(database)/documents/rooms/$(roomId)).data.awardedCardIds.size() + 1
                  && getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.lastCardEvent.type == 'awarded'
                  && getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.lastCardEvent.actorUid == playerId
                )
              )
              && (
                (incoming().pendingDoubleTurn == existing().pendingDoubleTurn && incoming().doublePenaltyUsed == existing().doublePenaltyUsed)
                || (
                  existing().pendingDoubleTurn == true
                  && existing().doublePenaltyUsed == false
                  && incoming().pendingDoubleTurn == false
                  && incoming().doublePenaltyUsed == true
                  && getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.turnQuestionsRemaining == 2
                )
              )
            )
            ||
            // Host resets player game stats for Play Again
            (
              get(/databases/$(database)/documents/rooms/$(roomId)).data.hostId == request.auth.uid
              && incoming().score == 0
              && incoming().skipsRemaining == 3
              && incoming().skipsUsed == 0
              && incoming().pendingDoubleTurn == false
              && incoming().doublePenaltyUsed == false
              && incoming().goldCards == 0
              && incoming().switchCards == 0
              && incoming().antiSwitchCards == 0
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'score', 'skipsRemaining', 'skipsUsed', 'pendingDoubleTurn',
                'doublePenaltyUsed', 'goldCards', 'switchCards', 'antiSwitchCards'
              ])
              && getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.gameNumber
                == get(/databases/$(database)/documents/rooms/$(roomId)).data.gameNumber + 1
            )
            ||
            // Host promotion / demotion during host transfer
            (
              incoming().diff(existing()).affectedKeys().hasOnly(['isHost'])
              && (
                (incoming().isHost == true && playerId == getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.hostId)
                || (incoming().isHost == false && playerId == get(/databases/$(database)/documents/rooms/$(roomId)).data.hostId)
              )
            )
          );

        allow delete: if isSignedIn()
          && isValidRoomCode(roomId)
          && isValidId(playerId)
          && (
            playerId == request.auth.uid
            || get(/databases/$(database)/documents/rooms/$(roomId)).data.hostId == request.auth.uid
          )
          && !(playerId in getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.playerOrder);
      }

      // Room-Scoped Real-Time Text & Voice Chat
      match /messages/{messageId} {
        allow get: if isSignedIn()
          && isValidRoomCode(roomId)
          && isValidId(messageId)
          && isRoomMember(roomId);
        allow list: if isSignedIn()
          && isValidRoomCode(roomId)
          && request.auth.uid in resource.data.memberIds;

        allow create: if isSignedIn()
          && isValidRoomCode(roomId)
          && isValidId(messageId)
          && isRoomMember(roomId)
          && isValidRoomChatMessage(incoming());

        allow update, delete: if false;
      }

      // Per-User Real-Time Message Reactions (Isolated Owner Write/Delete)
      match /messageReactions/{reactionId} {
        allow get: if isSignedIn()
          && isValidRoomCode(roomId)
          && isValidId(reactionId)
          && isRoomMember(roomId);
        allow list: if isSignedIn()
          && isValidRoomCode(roomId)
          && request.auth.uid in resource.data.memberIds;

        allow create: if isSignedIn()
          && isValidRoomCode(roomId)
          && isValidId(reactionId)
          && isRoomMember(roomId)
          && isValidMessageReaction(incoming(), reactionId);

        allow update: if isSignedIn()
          && isValidRoomCode(roomId)
          && isValidId(reactionId)
          && isRoomMember(roomId)
          && existing().userId == request.auth.uid
          && incoming().messageId == existing().messageId
          && incoming().reactionId == existing().reactionId
          && incoming().userId == existing().userId
          && isValidMessageReaction(incoming(), reactionId);

        allow delete: if isSignedIn()
          && isValidRoomCode(roomId)
          && isValidId(reactionId)
          && existing().userId == request.auth.uid;
      }

      // Ephemeral Room Chat Typing & Recording Presence
      match /chatPresence/{presenceUid} {
        allow get: if isSignedIn()
          && isValidRoomCode(roomId)
          && isValidId(presenceUid)
          && isRoomMember(roomId);
        allow list: if isSignedIn()
          && isValidRoomCode(roomId)
          && request.auth.uid in resource.data.memberIds;

        allow create, update: if isSignedIn()
          && isValidRoomCode(roomId)
          && isValidId(presenceUid)
          && presenceUid == request.auth.uid
          && isRoomMember(roomId)
          && isValidChatPresence(incoming());

        allow delete: if isSignedIn()
          && isValidRoomCode(roomId)
          && isValidId(presenceUid)
          && presenceUid == request.auth.uid;
      }

      // Ephemeral WebRTC Voice Signaling (SDP & ICE only - zero audio stored)
      match /voiceSignals/{signalId} {
        allow get: if isSignedIn()
          && isValidRoomCode(roomId)
          && isRoomMember(roomId)
          && (existing().toUid == request.auth.uid || existing().fromUid == request.auth.uid);
        allow list: if isSignedIn()
          && isValidRoomCode(roomId)
          && (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid);

        allow create: if isSignedIn()
          && isValidRoomCode(roomId)
          && isRoomMember(roomId)
          && incoming().keys().hasAll(['fromUid', 'toUid', 'type', 'payload', 'createdAt'])
          && incoming().keys().hasOnly(['fromUid', 'toUid', 'type', 'payload', 'createdAt'])
          && incoming().fromUid == request.auth.uid
          && isValidId(incoming().toUid)
          && incoming().toUid != request.auth.uid
          && exists(/databases/$(database)/documents/rooms/$(roomId)/players/$(incoming().toUid))
          && incoming().type in ['offer', 'answer', 'ice']
          && incoming().payload is string && incoming().payload.size() >= 2 && incoming().payload.size() <= 16384
          && incoming().createdAt == request.time;

        allow update: if false;

        allow delete: if isSignedIn()
          && isValidRoomCode(roomId)
          && (existing().toUid == request.auth.uid || existing().fromUid == request.auth.uid);
      }
    }
  }
}
